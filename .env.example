# ============================================================
# RAVZEN DIGI UNIVERSE — Environment Variables Template
# Copy this file to .env.local and fill in ALL values before
# running locally.  On Vercel, add these in the dashboard under
# Project → Settings → Environment Variables.
# ============================================================

# ------------------------------------------------------------------
# Supabase (REQUIRED)
# Find these in: Supabase Dashboard → Project → Settings → API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# ⚠️  SECRET — never expose in client code or public repos
# Used only in server-side API routes (src/lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# ------------------------------------------------------------------
# Site URL (REQUIRED)
# Development : http://localhost:3000
# Production  : https://your-domain.com  (no trailing slash)
# Also add this URL to Supabase → Auth → URL Configuration
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Activity counter multiplier (optional, default: 3)
# The displayed activity number = real count × this multiplier.
# Applied server-side only; safe to be public.
# ------------------------------------------------------------------
NEXT_PUBLIC_ACTIVITY_MULTIPLIER=3

# ------------------------------------------------------------------
# Contact / CTA links (REQUIRED for production CTAs)
# Used in ClosingExperience and ProjectDetailModal
# ------------------------------------------------------------------
# WhatsApp — international format without spaces or dashes, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP=<your-whatsapp-number>

# Email address for project inquiry button
NEXT_PUBLIC_EMAIL=<your-contact-email>
